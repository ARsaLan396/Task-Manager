@using Task_Manager.Application.Services.Task.Queries
@model List<GetTaskDto>
@{
    ViewData["Title"] = "مدیریت تسک‌ها";
}

<div class="container mt-5" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">📋 لیست تسک‌های من</h2>
        <button type="button" class="btn btn-primary px-4" data-bs-toggle="modal" data-bs-target="#addTaskModal">
            + افزودن تسک جدید
        </button>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-secondary text-center py-4">
            هنوز هیچ تسکی اضافه نکردی. یکی بساز! 🚀
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var task in Model)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center py-3 @(task.IsCompleted ? "bg-light text-muted" : "")">
                    <div>
                        <h5 class="mb-1 @(task.IsCompleted ? "text-decoration-line-through" : "")">
                            @task.Title
                        </h5>
                        <p class="mb-1 small">@task.Description</p>
                        <small class="text-muted">تاریخ ایجاد: @task.CreatedDate.ToString("yyyy/MM/dd")</small>
                    </div>
                    <div class="d-flex gap-2">
                        @if (task.IsCompleted)
                        {
                            <button class="btn btn-sm btn-outline-danger"
                                    onclick="toggleComplete(@task.Id)">
                                ✖️
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-success"
                                    onclick="toggleComplete(@task.Id)">
                                ✔️
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-warning"
                                data-bs-toggle="modal"
                                data-bs-target="#editTaskModal"
                                onclick="fillEditModal(@task.Id, '@task.Title', '@task.Description')">
                            ✏️ ویرایش
                        </button>
                        <button class="btn btn-sm btn-outline-danger"
                                onclick="deleteTask(@task.Id)">
                            🗑️ حذف
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Modal افزودن تسک -->
<div class="modal fade" id="addTaskModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" dir="rtl">
            <form asp-action="Add" asp-controller="Task" method="post" id="Addtask">
                <div class="modal-header">
                    <h5 class="modal-title">افزودن تسک جدید</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">عنوان</label>
                        <input type="text" name="Title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea name="Description" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary">ذخیره</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal ویرایش تسک -->
<div class="modal fade" id="editTaskModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" dir="rtl">
            <form id="editForm" asp-action="Update" asp-controller="Task" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">ویرایش تسک</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="Id" id="edit-id" />
                    <div class="mb-3">
                        <label class="form-label">عنوان</label>
                        <input type="text" name="Title" id="edit-title" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea name="Description" id="edit-description" class="form-control" rows="3" required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-warning">ذخیره تغییرات</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal نمایش پیغام-->
<div class="modal fade" id="messageModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" dir="rtl">
            <div class="modal-header">
                <h5 class="modal-title" id="messageModalTitle">پیام</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="messageModalBody"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">باشه</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
             document.getElementById('Addtask').addEventListener('submit', function (event) {
            event.preventDefault();
            const formData = new FormData(this);

            fetch('/Task/Add', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(result => {
                       const addModal = bootstrap.Modal.getInstance(document.getElementById('addTaskModal'));
                        addModal.hide();

                    document.getElementById('messageModalBody').textContent = result.message;
                    new bootstrap.Modal(document.getElementById('messageModal')).show();

                if (result.isSucsses) {
                                 setTimeout(() => {
                                    location.reload();
                                    }, 5000);
                }
            });
        });

        function fillEditModal(id, title, description) {
            document.getElementById('editForm').addEventListener('submit', function (event) {
            event.preventDefault();
            const formData = new FormData(this);

            fetch('/Task/Update', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(result => {
                       const addModal = bootstrap.Modal.getInstance(document.getElementById('editTaskModal'));
                        addModal.hide();

                    document.getElementById('messageModalBody').textContent = result.message;
                    new bootstrap.Modal(document.getElementById('messageModal')).show();

                if (result.isSucsses) {
                                 setTimeout(() => {
                                    location.reload();
                                    }, 5000);
                }
            });
        });
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-title').value = title;
            document.getElementById('edit-description').value = description;
        }

        function deleteTask(id) {
            if (confirm('مطمئنی می‌خوای این تسک رو حذف کنی؟')) {
                fetch(`/Task/Delete/${id}`, { method: 'POST' })
                    .then(() => location.reload());
            }
        }

                function toggleComplete(id) {
            fetch(`/Task/ToggleComplete/${id}`, { method: 'POST' })
                .then(response => response.json())
                .then(result => {
                    document.getElementById('messageModalBody').textContent = result.message;
                    new bootstrap.Modal(document.getElementById('messageModal')).show();

                    if (result.isSucsses) {
                        setTimeout(() => {
                            location.reload();
                        }, 3000);
                    }
                });
        }
    </script>
}
